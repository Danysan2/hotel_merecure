NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Bogota

# Base de datos Postgres existente. DIRECT_URL puede ser igual a DATABASE_URL
# cuando la conexion no utiliza un pooler.
DATABASE_URL=postgresql://usuario:clave@host-postgres:5432/merecure?schema=public
DIRECT_URL=postgresql://usuario:clave@host-postgres:5432/merecure?schema=public
SHADOW_DATABASE_URL=

ADMIN_SESSION_SECRET=cambia-este-secreto-largo
N8N_RESERVATION_WEBHOOK=
