NODE_ENV=production
PORT=3014
APP_TIMEZONE=America/Bogota

# Base de datos Postgres existente. Si no necesitas una URL directa distinta,
# deja DIRECT_URL vacia y Prisma usara DATABASE_URL para las migraciones.
DATABASE_URL=postgresql://usuario:clave@host-postgres:5432/merecure?schema=public
DIRECT_URL=
SHADOW_DATABASE_URL=

ADMIN_SESSION_SECRET=cambia-este-secreto-largo
N8N_RESERVATION_WEBHOOK=
